# Copy to .env, chmod 600, and set unique secrets. Do not commit .env.
# Main beta image; for the tested development branch use docker-preview.
AUSSIETV_IMAGE=ghcr.io/zidanerick/aussietv:experimental-v0.1.0-beta.1
# Web UI: loopback by default. Set exact HTTPS origin for a trusted proxy.
AUSSIETV_HOST_BIND=127.0.0.1
AUSSIETV_WEB_ORIGIN=http://127.0.0.1:45781
AUSSIETV_WEB_USER=viewer
AUSSIETV_WEB_PASSWORD=
# Jellyfin: set host bind and base URL to the reachable private address.
AUSSIETV_FEED_HOST_BIND=127.0.0.1
AUSSIETV_JELLYFIN_BASE_URL=http://127.0.0.1:45782
AUSSIETV_JELLYFIN_KEY=
AUSSIETV_JELLYFIN_REGION=Melbourne
AUSSIETV_JELLYFIN_STREAM_MODE=redirect
AUSSIETV_EXTRA_AU_CHANNELS=0
AUSSIETV_PROVIDERS_FILE=
AUSSIETV_TELETEXT_VIDEO=0
AUSSIETV_TELETEXT_CONFIG=
AUSSIETV_JELLYFIN_ARTWORK_SYNC=0
AUSSIETV_JELLYFIN_SERVER_URL=
AUSSIETV_JELLYFIN_API_KEY=
